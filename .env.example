# Port (Render sets this automatically to 10000 or process.env.PORT)
PORT=3001

# Database connection string
DATABASE_URL="file:./dev.db"

# JWT Secret Key
JWT_SECRET=super-secure-secret-key-change-in-production

# Node environment
NODE_ENV=development

# Allowed CORS origins (* for any or https://your-frontend.vercel.app)
CORS_ORIGINS=*

# Real sports feed provider: Bzzoiro Sports Data (https://sports.bzzoiro.com/dashboard/)
# Get a free API key, then set it here (or as an env var on Render).
BZZOIRO_API_KEY=your_bzzoiro_api_key_here
# Optional: override API base URL (default https://sports.bzzoiro.com)
# BZZOIRO_API_BASE=https://sports.bzzoiro.com
# Optional: how many per-event odds lookups each sync performs (live first, then
# soonest kick-offs). Default 60. Lower it (e.g. 24) if the API answers 429.
# ODDS_EVENT_LIMIT=60