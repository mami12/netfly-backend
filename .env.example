# Port (Render sets this automatically to 10000 or process.env.PORT)
PORT=3001

# Database connection string
DATABASE_URL="file:./dev.db"

# JWT Secret Key
JWT_SECRET=super-secure-secret-key-change-in-production

# Node environment
NODE_ENV=development

# Allowed CORS origins (* for any or https://your-frontend.vercel.app)
CORS_ORIGINS=*